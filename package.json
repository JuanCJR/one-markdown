{
  "name": "one-markdown",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "shared:build": "pnpm --filter @one-markdown/shared build",
    "test": "pnpm shared:build && pnpm -r test",
    "test:e2e": "pnpm shared:build && pnpm --filter @one-markdown/web test:e2e",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm shared:build && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  }
}
