# --- Base de datos (Prisma / MCP postgres) ---
DATABASE_URL="postgresql://one_markdown:one_markdown@localhost:5432/one_markdown?schema=public"
DATABASE_URL_TEST="postgresql://one_markdown:one_markdown@localhost:5432/one_markdown_test?schema=public"

# --- Redis (sesiones, refresh tokens, rate limit, cache) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_ACCESS_SECRET="cambiar-en-local"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="cambiar-en-local"
JWT_REFRESH_TTL="7d"
BCRYPT_ROUNDS="12"
MFA_ISSUER="One Markdown"
MFA_SECRET_ENCRYPTION_KEY="cambiar-en-local-32-bytes-min"

# --- API ---
API_PORT="3000"
API_CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# --- Web ---
VITE_API_URL="http://localhost:3000"

# --- Opcional: Context7 MCP (mayor rate limit) ---
# CONTEXT7_API_KEY=""
