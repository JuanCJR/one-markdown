{
  "enabledMcpjsonServers": [
    "context7",
    "playwright",
    "coderag",
    "postgres"
  ],
  "permissions": {
    "allow": [
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)",
      "Bash(git add:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(npx nest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx prisma:*)",
      "Bash(npx vitest:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm -r:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm install)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)"
    ],
    "deny": [
      "Bash(docker compose down -v:*)",
      "Bash(git push:*)",
      "Bash(npx prisma migrate reset:*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .harness/hooks/delegation-watch.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .harness/hooks/log-skill-usage.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
